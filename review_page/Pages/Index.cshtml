@page
@model IndexModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-xl-6 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h4 mb-4 text-center">Create Review Request</h1>

                    <form method="post" asp-page-handler="Submit" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Input.BusinessName" class="form-label"></label>
                            <input asp-for="Input.BusinessName" class="form-control" />
                            <span asp-validation-for="Input.BusinessName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.RecipientEmail" class="form-label"></label>
                            <input asp-for="Input.RecipientEmail" class="form-control" />
                            <span asp-validation-for="Input.RecipientEmail" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.RecipientName" class="form-label"></label>
                            <input asp-for="Input.RecipientName" class="form-control" />
                            <span asp-validation-for="Input.RecipientName" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Input.SendEmail" class="form-check-input" />
                            <label asp-for="Input.SendEmail" class="form-check-label"></label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-between">
                            <button type="submit" class="btn btn-primary">Generate</button>
                            <button type="button" onclick="downloadExcel()" class="btn btn-outline-secondary">Download Excel</button>
                            <button type="button" onclick="downloadPdf()" class="btn btn-outline-secondary">Download PDF</button>
                            <button type="button" onclick="redirectToReviewLink()" class="btn btn-outline-info">Get Review Link</button>
                        </div>
                    </form>

                    @if (Model.GeneratedReview is not null)
                    {
                        <div class="card mt-4">
                            <div class="card-body">
                                <h2 class="h5">Place Found</h2>
                                <p class="mb-1"><strong>Place:</strong> @Model.GeneratedReview.PlaceName</p>
                                <p class="mb-1">
                                    <strong>Review URL:</strong>
                                    <a href="@Model.GeneratedReview.ReviewURL" target="_blank">@Model.GeneratedReview.ReviewURL</a>
                                </p>
                                <p class="mb-3"><strong>Email sent:</strong> @(Model.GeneratedReview.EmailSent ? "Yes" : "No")</p>
                                <div class="text-center">
                                    <img src="data:image/png;base64,@Model.GeneratedReview.QrCodeB64" alt="QR Code" class="img-fluid" style="max-width: 250px;" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    function downloadExcel() {
        window.location.href = '/api/review/export/excel';
    }

    function downloadPdf() {
        window.location.href = '/api/review/export/pdf';
    }

    function redirectToReviewLink() {
        const businessName = encodeURIComponent(document.querySelector('input[name="Input.BusinessName"]').value || '');
        const recipientEmail = encodeURIComponent(document.querySelector('input[name="Input.RecipientEmail"]').value || '');
        window.location.href = `/api/review/review-link?businessName=${businessName}&recipientEmail=${recipientEmail}`;
    }
</script>
